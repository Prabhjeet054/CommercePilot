# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (matches docker-compose postgres service)
# Host-run backend: use localhost. In Compose, the backend service overrides
# the hostname to `postgres`.
DATABASE_URL=postgresql://commercepilot:commercepilot@localhost:5432/commercepilot

# AI (OpenAI structured-output adapter; tests always use the in-process mock)
LLM_PROVIDER=openai
LLM_PROVIDER_API_KEY=replace-me

# Auth (placeholders only — replace before any non-local deploy)
JWT_SECRET=phase3-dev-access-secret-change-me
JWT_REFRESH_SECRET=phase3-dev-refresh-secret-change-me
COOKIE_SECURE=false

# Approvals (Phase 12) — single-use window, default 15 minutes
APPROVAL_TTL_MINUTES=15

# Razorpay Test Mode (Phase 15). Key ID is public; Key Secret is backend-only.
# Placeholders — never commit real dashboard values.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
# Distinct from KEY_SECRET — set in Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=replace-me

# Phase 22 — payment reconciliation (demo defaults; tunable).
# Stuck PAYMENT_PENDING / PAYMENT_AUTHORIZED beyond this age triggers status-fetch.
PAYMENT_RECONCILE_TIMEOUT_SECONDS=60
PAYMENT_RECONCILE_MAX_ATTEMPTS=3
# Exponential backoff between status-fetch attempts (ms).
PAYMENT_RECONCILE_BACKOFF_MS=1000,4000,16000
